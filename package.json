{
  "name": "morgue-file",
  "version": "1.0.1",
  "private": true,
  "description": "A personal reference archive for painters, served at localhost on Windows.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#core/*": {
      "types": "./src/core/*",
      "default": "./dist/core/*"
    },
    "#server/*": {
      "types": "./src/server/*",
      "default": "./dist/server/*"
    }
  },
  "scripts": {
    "dev": "npm run build && node dist/server/main.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.css\"",
    "check:readme": "node scripts/check-readme.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run check:readme && npm run typecheck && npm run test",
    "test:e2e": "npm run build && playwright test --project=e2e",
    "test:visual": "npm run build && playwright test --project=visual --pass-with-no-tests",
    "test:perf": "npm run build && playwright test --project=perf --pass-with-no-tests",
    "package": "node scripts/package-win.ts",
    "setup-repo": "node scripts/setup-repo.ts"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.41",
    "fastify": "^5.6.0",
    "preact": "^10.27.0",
    "preact-render-to-string": "^6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-jsdoc": "^61.0.0",
    "marked": "^16.4.2",
    "prettier": "^3.6.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
